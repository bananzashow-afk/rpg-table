# Один адрес для сайта + API + WebSocket
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=*
PUBLIC_URL=https://rpg-table-purrple.fly.dev
# After Fly login: set FLY_API_TOKEN in the environment (never commit the token)
# PUBLIC_TUNNEL_HOST is only for optional local Tunnelmole while the PC is on
PUBLIC_TUNNEL_HOST=
SESSION_TTL_MS=86400000

# Пусто = same-origin (клиент ходит на тот же хост, что открыт в браузере)
VITE_WS_URL=
